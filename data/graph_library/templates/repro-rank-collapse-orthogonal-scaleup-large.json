          "inputDim": 256,
          "outputDim": 4,
          "trainSize": 256,
          "testSize": 0,
          "frequencyRatio": 2.0,
          "classSeparation": 1.0,
          "seed": 0,
          "samplingMode": "fixed",
          "instanceTitle": "Orthogonal full train set \u00b7 X=I256 \u00b7 counts 137/68/34/17"
        }
