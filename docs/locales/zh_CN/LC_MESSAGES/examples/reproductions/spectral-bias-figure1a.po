msgstr "等幅目标为"

#: ../../docs/en/examples/reproductions/spectral-bias-figure1a.md:70
#, python-brace-format
msgid ""
"\n"
"f(x) = \\sum_{i=1}^{10} \\sin(2\\pi k_i x + \\phi_i),\n"
msgstr ""
"\n"
"f(x) = \\sum_{i=1}^{10} \\sin(2\\pi k_i x + \\phi_i),\n"

#: ../../docs/en/examples/reproductions/spectral-bias-figure1a.md:74
#, python-brace-format
msgid ""
"with $k_i \\in \\{5, 10, \\ldots, 50\\}$ and independently sampled phases"
" $\\phi_i$. Equal amplitudes isolate frequency as the ordered variable."
msgstr "其中 $k_i \\in \\{5, 10, \\ldots, 50\\}$，各相位 $\\phi_i$ 独立采样。等幅设置将频率单独作为排序变量。"

#: ../../docs/en/examples/reproductions/spectral-bias-figure1a.md:77
msgid "The main observable is the normalized Fourier amplitude"
msgstr "主要的 observable 是归一化的 Fourier 幅值"

#: ../../docs/en/examples/reproductions/spectral-bias-figure1a.md:79
msgid ""
"\n"
"\\frac{2\\left|\\operatorname{DFT}(f_\\theta)[k_i]\\right|}{A_i},\n"
msgstr ""
"\n"
"\\frac{2\\left|\\operatorname{DFT}(f_\\theta)[k_i]\\right|}{A_i},\n"

